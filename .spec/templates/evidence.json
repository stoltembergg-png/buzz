{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buzz.local/.spec/templates/evidence.schema.json",
  "title": "Evidence record",
  "description": "Records commands, outputs, and exit codes that prove a Definition of Done criterion. Includes the final SHA, platform, and tool versions so the evidence is reproducible.",
  "type": "object",
  "required": ["id", "task", "pr", "sha", "platform", "commands", "results"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^E-[A-Z]+-\\d{3}$",
      "description": "Stable evidence identifier (mirrors the REQ/AC taxonomy)."
    },
    "task": {
      "type": "string",
      "pattern": "^T-[A-Z]+-\\d{3}$",
      "description": "Task identifier this evidence supports."
    },
    "pr": {
      "type": "string",
      "pattern": "^PR-\\d{3}$",
      "description": "Roadmap PR number (matches PR-001 numbering)."
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$",
      "description": "Final commit SHA at the time the command was run."
    },
    "platform": {
      "type": "object",
      "required": ["os", "arch"],
      "properties": {
        "os": { "type": "string", "examples": ["windows-10", "ubuntu-24.04", "macos-15"] },
        "arch": { "type": "string", "enum": ["x86_64", "aarch64", "x86"] }
      }
    },
    "tools": {
      "type": "object",
      "description": "Tool versions (rust, node, pnpm, etc.) — keys are tool names, values are version strings.",
      "additionalProperties": { "type": "string" }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cmd", "exit"],
        "properties": {
          "cmd": { "type": "string", "description": "Exact command as executed." },
          "exit": { "type": "integer", "description": "Process exit code (0 = success)." },
          "stdout": { "type": "string", "description": "Relevant slice of stdout (truncated to first 2 KB)." },
          "stderr": { "type": "string", "description": "Relevant slice of stderr (truncated to first 2 KB)." },
          "duration_ms": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "results": {
      "type": "object",
      "description": "Free-form result summary — pass/fail counts, names of artifacts, etc.",
      "additionalProperties": true
    },
    "links": {
      "type": "array",
      "description": "Optional URLs (CI runs, screenshots, logs).",
      "items": { "type": "string", "format": "uri" }
    }
  },
  "additionalProperties": false
}
